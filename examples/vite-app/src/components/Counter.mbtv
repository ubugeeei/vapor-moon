<script>
import {
  "mizchi/luna/js/resource" @reactivity,
  let signal = @reactivity.signal,
}

let count = signal(0)
</script>

<template>
  <section class='counter'>
    <h1>Vapor Moon × Vite+</h1>
    <p>The button below is rendered by `render_dom` from a `.mbtv` source compiled at Vite+ module-resolution time.</p>
    <button type='button' @click='count.update(fn(n) { n + 1 })'>
      Clicked {{ count.get().to_string() }} times
    </button>
  </section>
</template>

