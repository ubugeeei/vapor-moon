{
  "name": "vapor-moon",
  "displayName": "Vapor Moon",
  "description": "Language support and LSP client for Vapor Moon .mbtv components.",
  "version": "0.2.0",
  "publisher": "ubugeeei",
  "license": "MIT",
  "author": {
    "name": "ubugeeei"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ubugeeei/vapor-moon.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/ubugeeei/vapor-moon/issues"
  },
  "homepage": "https://github.com/ubugeeei/vapor-moon#readme",
  "keywords": [
    "moonbit",
    "mbtv",
    "vapor",
    "vue",
    "sfc",
    "single-file-component"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:vapor-moon"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "contributes": {
    "languages": [
      {
        "id": "vapor-moon",
        "aliases": [
          "Vapor Moon",
          "mbtv"
        ],
        "extensions": [
          ".mbtv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "vapor-moon",
        "path": "./snippets/vapor-moon.json"
      }
    ],
    "grammars": [
      {
        "language": "vapor-moon",
        "scopeName": "text.html.vapor-moon",
        "path": "./syntaxes/vapor-moon.tmLanguage.json",
        "embeddedLanguages": {
          "source.moonbit.embedded.vapor-moon": "moonbit",
          "source.css.embedded.vapor-moon": "css"
        }
      }
    ],
    "configuration": {
      "title": "Vapor Moon",
      "properties": {
        "vaporMoon.languageServer.command": {
          "type": "string",
          "default": "",
          "description": "Override the Vapor Moon language server command. Leave empty to auto-detect the repo-local launcher or use vapor-moon-lsp from PATH."
        },
        "vaporMoon.languageServer.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to the Vapor Moon language server."
        },
        "vaporMoon.languageServer.cwd": {
          "type": "string",
          "default": "",
          "description": "Working directory for the Vapor Moon language server. Leave empty to use the first workspace folder."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
